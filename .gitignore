# macOS Finder metadata
.DS_Store

# Virtual environment
.venv/

# Python caches and build metadata
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Data and generated outputs: ignore the contents, keep each folder through .gitkeep.
# ("folder/*" rather than "folder/", because git cannot re-include a file whose parent
# directory is ignored.) Raw files may be symlinks to wherever the data lives.
data/raw/*
data/processed/*
models/*
reports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/.gitkeep
# Demo outputs are regenerated by "python -m amlcore.cli run --demo"; only the raw files are kept.
data/demo/processed/
data/demo/models/
data/demo/reports/

